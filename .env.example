# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=patlixworld
DB_PASSWORD=patlixworld
DB_NAME=patlixworld
DB_SYNCHRONIZE=true

# Server (3004 to avoid collisions: patlix :3000, arkadion :3001, falina :3002, aurel :3003)
PORT=3004

# Auth
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# LLM provider chain (tried in order; OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# OpenCode CLI (real tool execution)
OPENCODE_BIN=opencode

# World
WORLD_SPAWN_ZONE=beach
WORLD_PLAYER_MODEL=player.glb